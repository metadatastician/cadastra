#
# STATE.a2ml — Project state checkpoint
#
# REWRITTEN FOR THIS REPO 2026-07-16. The template ships this file describing
# rsr-template-repo's OWN state (95% complete, production, its milestones), with a
# "NOTE FOR CONSUMERS" saying to reset it. `just init` does not do that, so an
# uncorrected instantiation claims the template's maturity as its own — a day-old
# repo reporting "production / 95% complete". Same class of bug as the inherited
# CLADE identity; see CLADE.a2ml.

[metadata]
project = "cadastra"
version = "0.1.0"
last-updated = "2026-07-16"
status = "active"  # active | paused | archived

[project-context]
name = "cadastra"
purpose = "Canonical register and survey of the estate's repos: houses the estate-migration-toolkit and the triage reports it produces. Records what is actually out there, observed by running the tool."
completion-percentage = 5

[position]
phase = "implementation"   # design | implementation | testing | maintenance | archived
maturity = "experimental"  # experimental | alpha | beta | production | lts

[route-to-mvp]
milestones = [
  { name = "Phase 0: Repo born from RSR template; identity corrected at birth (CLADE/ECOSYSTEM/STATE)", completion = 100 },
  { name = "Phase 1: Estate-migration-toolkit housed; estate-scan.sh fixed at source (3 defects)", completion = 100 },
  { name = "Phase 1b: First full estate survey landed (762 rows, 2026-07-16)", completion = 100 },
  { name = "Phase 2: Triage the 8 KILL rows with the owner", completion = 0 },
  { name = "Phase 3: Reduce DIRECT_FFI_NO_HEXADECA false-positive rate (457/762 rows is not credible as-is)", completion = 0 },
  { name = "Phase 4: Repeatable/scheduled scan + report diffing (survey trend, not one snapshot)", completion = 0 },
  { name = "Phase 5: Decide whether a filtered, publishable report is wanted", completion = 0 },
]

[blockers-and-issues]
issues = [
  "UPSTREAM (rsr-template-repo), reported not patched: `just verify` fails on a fresh instantiation — it checks CONTRIBUTING.md/SECURITY.md at root only, but root-allow.txt states .github/ is the canonical estate location and that CI checks both. assess.just:204 is stale. The template does not pass its own gate.",
  "UPSTREAM (rsr-template-repo), reported not patched: the template fails its own scripts/check-root-shape.sh — .githooks/ is tracked but absent from .machine_readable/root-allow.txt. Allow-listed locally here with justification.",
  "UPSTREAM (rsr-template-repo), reported not patched: `just init` never touches CLADE.a2ml/ECOSYSTEM.a2ml/STATE.a2ml, so every new repo inherits the template's identity, ecosystem and maturity. Corrected by hand here. paint-type and scaffoldia still carry the inherited uuid.",
  "UPSTREAM (gv-clade-index), reported not patched: sync/deploy-clade-a2ml.sh hardcodes the owner path to `hyperpolymath`, so it would recompute a wrong uuid for any metadatastician-owned repo, including this one.",
  "This repo is NOT registered in gv-clade-index. Registration is outward-facing and is the owner's act (doctrine 11).",
  "`just init` leaves tokens it has no answers for ({{PACKAGE_NAME}}, {{PGP_KEY_URL}}, {{TEST_CMD}}, {{LANG_STACK}}, {{BUILD_CMD}}, {{DEPS}}, {{DESCRIPTION}}) — they are not in its SED_ARGS list. Unresolved here.",
]

[critical-next-actions]
actions = [
  "Owner: adjudicate the 8 KILL rows — classification is a statement about observed code, never about a project's worth.",
  "Owner: decide whether to register cadastra in gv-clade-index (and resolve the hardcoded-owner defect first, or it will overwrite this repo's uuid).",
  "Treat DIRECT_FFI_NO_HEXADECA (457/762) as a lead, not a finding — its pattern matches bare `extern \"C\"`, i.e. ordinary FFI and vendored C.",
  "Re-run the scan before trusting the report: it is an observation dated 2026-07-16, stale the moment a scanned repo changes.",
]

[maintenance-status]
last-run-utc = "2026-07-16"
last-report = "docs/status/estate-triage-report.csv"
last-result = "pass"     # unknown | pass | warn | fail — scan exited 0 with no INCOMPLETE marker
open-warnings = 0
open-failures = 0

[ecosystem]
part-of = ["RSR Framework"]
depends-on = ["gh", "jq", "git"]   # the scan's actual runtime requirements

# ---------------------------------------------------------------------------
# DATA SENSITIVITY: docs/status/estate-triage-report.csv names 46 repos that are
# PRIVATE on GitHub. This repo is PRIVATE for that reason — a deliberate decision.
# See the DATA SENSITIVITY note in ECOSYSTEM.a2ml before changing visibility.
# ---------------------------------------------------------------------------
